rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isFarmer() {
      return hasRole('FARMER');
    }

    // Check if user is assigned to a device
    function isAssignedToDevice(deviceId) {
      let assignmentId = request.auth.uid + "_" + deviceId;
      return exists(/databases/$(database)/documents/deviceAssignments/$(assignmentId));
    }

    // USERS collection
    match /users/{uid} {
      allow read: if isSignedIn();
      // Public self-registration may establish only an unlinked ADMIN profile.
      // FARMER/PERSONNEL profiles are created by an authenticated Admin.
      // isDeveloper gates the developer-only subset of the app's Developer
      // Options screen (Mock Sensors, Automation Test Mode, the water-level
      // safety bypass, Canopy PWM raw commands) and must only ever be set via
      // the Firebase Console/Admin SDK, which bypass these rules entirely -
      // self-registration otherwise has no field whitelist here (unlike
      // update below, which uses hasOnly()), so without this check any
      // signed-up user could set isDeveloper: true on their own document.
      allow create: if (isSignedIn() && request.auth.uid == uid &&
                        request.resource.data.role == 'ADMIN' &&
                        request.resource.data.ownerAdminUid == null &&
                        (!('isDeveloper' in request.resource.data) || request.resource.data.isDeveloper == false) &&
                        (!('developerTester' in request.resource.data) || request.resource.data.developerTester == false)) ||
        (isAdmin() && request.resource.data.role == 'FARMER' &&
         request.resource.data.ownerAdminUid == request.auth.uid &&
         (!('isDeveloper' in request.resource.data) || request.resource.data.isDeveloper == false) &&
         (!('developerTester' in request.resource.data) || request.resource.data.developerTester == false));
      // Personnel may maintain their contact profile only.  An admin can only link,
      // unlink, or edit a FARMER profile that is unlinked or already belongs to them.
      allow update: if (request.auth.uid == uid &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone', 'fcmToken']) &&
                        (!('fcmToken' in request.resource.data) || request.resource.data.fcmToken is string)) ||
        (isAdmin() && resource.data.role == 'FARMER' && request.resource.data.role == 'FARMER' &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['developerTester']) &&
         (resource.data.ownerAdminUid == null || resource.data.ownerAdminUid == request.auth.uid) &&
         (request.resource.data.ownerAdminUid == null || request.resource.data.ownerAdminUid == request.auth.uid));
      allow delete: if isAdmin() && resource.data.ownerAdminUid == request.auth.uid;
    }

    // DEVICES collection
    match /devices/{deviceId} {
      allow read: if isSignedIn() && (isAdmin() || isAssignedToDevice(deviceId));
      // Ownership is a state transition, not a general admin-editable field.  In
      // particular, an unclaimed document (including one legitimately unclaimed
      // moments earlier) can only be claimed by the authenticated admin, while a
      // claimed document can only be unclaimed by that same owner.
      allow update: if isAdmin() && (
        isValidClaimTransition() ||
        isValidUnclaimTransition() ||
        (resource.data.ownerUid == request.auth.uid &&
         request.resource.data.ownerUid == request.auth.uid)
      );
      allow create, delete: if isAdmin();

      function changesOnlyClaimState() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['ownerUid', 'status']);
      }

      function isValidClaimTransition() {
        return (!('ownerUid' in resource.data) || resource.data.ownerUid == null) &&
          (!('status' in resource.data) || resource.data.status != 'CLAIMED') &&
          request.resource.data.ownerUid == request.auth.uid &&
          request.resource.data.status == 'CLAIMED' &&
          changesOnlyClaimState();
      }

      function isValidUnclaimTransition() {
        return resource.data.ownerUid == request.auth.uid &&
          request.resource.data.ownerUid == null &&
          request.resource.data.status == 'UNCLAIMED' &&
          changesOnlyClaimState();
      }

      // CYCLES sub-collection
      match /cycles/{cycleId} {
        allow read: if isSignedIn() && (isAdmin() || isAssignedToDevice(deviceId));
        // Starting a cultivation cycle is farm work: an Admin or an assigned
        // Farmer may create one for a device they are assigned to. Deletion
        // stays Admin-only - removing cycle history is administration.
        // createdBy is pinned to the caller so a crafted request cannot
        // attribute a cycle to someone else. Nothing server-side creates
        // cycles (Cloud Functions only mirror them), so this breaks no
        // existing writer.
        allow create: if isSignedIn() && isAssignedToDevice(deviceId) &&
                        (isAdmin() || isFarmer()) &&
                        request.resource.data.createdBy == request.auth.uid;
        allow delete: if isAdmin() && isAssignedToDevice(deviceId);
        // Farmers can update cycle totals when logging a harvest, and can
        // perform the one specific ACTIVE -> COMPLETED transition below.
        //
        // 'status' is deliberately NOT in the harvest clause. addHarvestTransaction()
        // - the only cycle write a Farmer can reach that is not Admin-gated - writes
        // exactly totalHarvestWeight, totalHarvestCount, lastHarvestDate and
        // nextHarvestDate. Allowing 'status' there let a crafted request mark a cycle
        // COMPLETED with no endDate and no completedBy, bypassing the completion
        // clause entirely. Completion has one route: the clause at the end.
        //
        // The completion clause is deliberately narrow rather than a general
        // edit permission: it requires the cycle to currently be ACTIVE (which
        // also makes completing an already-completed cycle impossible),
        // requires the new status to be exactly COMPLETED, and allows only the
        // three fields completeCycle() actually writes. Cycle identity,
        // creator, numbering and harvest totals stay untouchable.
        // The admin clause stays broad, with one narrow integrity condition: a
        // write may only set completedBy to the caller's own UID. Writes that
        // do not touch completedBy (harvest totals, frequency edits) are
        // unaffected, so this needed no restructuring of the clause.
        // targetRanges is the historical record of what this cycle was grown
        // against, so it is written once at creation and never edited - by
        // anyone. Without this the broad admin clause below would let it be
        // rewritten, silently changing how a finished cycle's report reads.
        allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['targetRanges']) &&
                        ((isAdmin() && isAssignedToDevice(deviceId) &&
                         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['completedBy']) ||
                          request.resource.data.completedBy == request.auth.uid)) ||
                        (isFarmer() && isAssignedToDevice(deviceId) &&
                         (resource.data.nextHarvestDate == null || resource.data.nextHarvestDate <= request.time) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'harvestFrequency', 'lastHarvestDate',
                           'totalHarvestWeight', 'totalHarvestCount', 'nextHarvestDate'
                         ])) ||
                        (isFarmer() && isAssignedToDevice(deviceId) &&
                         resource.data.status == 'ACTIVE' &&
                         request.resource.data.status == 'COMPLETED' &&
                         request.resource.data.completedBy == request.auth.uid &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'status', 'endDate', 'nextHarvestDate', 'completedBy'
                         ])));

        // HARVEST LOGS sub-collection
        match /harvestLogs/{harvestId} {
          allow read: if isSignedIn() && (isAdmin() || isAssignedToDevice(deviceId));
          // Only an admin may edit/delete history.  A FARMER can add a new entry only
          // once the parent cycle's scheduled harvest time has arrived.
          allow create: if (isAdmin() && isAssignedToDevice(deviceId)) ||
            (isFarmer() && isAssignedToDevice(deviceId) &&
             (get(/databases/$(database)/documents/devices/$(deviceId)/cycles/$(cycleId)).data.nextHarvestDate == null ||
              get(/databases/$(database)/documents/devices/$(deviceId)/cycles/$(cycleId)).data.nextHarvestDate <= request.time) &&
             request.resource.data.recordedBy == request.auth.uid &&
             request.resource.data.harvestDate <= request.time);
          allow update, delete: if isAdmin() && isAssignedToDevice(deviceId);
        }
      }

      // PARAMETER LOGS sub-collection
      // Ingested only by Cloud Functions via the Admin SDK, which bypasses
      // these rules entirely - client write access here was never needed for
      // that path and only exposed an assigned Farmer to deleting/overwriting
      // a device's log history. Admin-only, matching the app's own intent
      // (the mock-log-injection debug tool in DevOptionsFragment is UI-gated
      // to Admin already).
      match /parameterLogs/{logId} {
        allow read: if isSignedIn() && (isAdmin() || isAssignedToDevice(deviceId));
        allow write: if isAdmin() && isAssignedToDevice(deviceId);
      }

      // FOGGING LOGS sub-collection - same reasoning as parameterLogs above.
      match /foggingLogs/{logId} {
        allow read: if isSignedIn() && (isAdmin() || isAssignedToDevice(deviceId));
        allow write: if isAdmin() && isAssignedToDevice(deviceId);
      }

      // NOTIFICATIONS sub-collection
      match /notifications/{notifId} {
        allow read: if isSignedIn() && (isAdmin() || isAssignedToDevice(deviceId));

        // Notification CONTENT is shared and immutable; READ STATE belongs to
        // the individual user and lives in the readBy map keyed by uid.
        //
        // Two conditions do the work. The first restricts the write to the
        // readBy field alone, so title/message/type/timestamp - and the legacy
        // isRead flag - can never be altered. The second diffs the readBy map
        // itself and permits exactly one affected key: the caller's own uid.
        // Any add, change or removal of another user's entry shows up in
        // affectedKeys and is refused. resource.data.get('readBy', {}) supplies
        // an empty map for the many documents that predate the field, so a
        // first-ever mark-as-read is valid.
        allow update: if isSignedIn()
          && (isAdmin() || isAssignedToDevice(deviceId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy.diff(resource.data.get('readBy', {}))
               .affectedKeys().hasOnly([request.auth.uid]);

        allow create, delete: if false;
      }
    }

    // DEVICE ASSIGNMENTS collection
    match /deviceAssignments/{assignmentId} {
      // Allow user to see their own assignments
      allow read: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      // Only the owning admin can manage assignments for that device. getAfter
      // permits the claim transaction to create its owner assignment atomically.
      allow create: if isAdmin() &&
        getAfter(/databases/$(database)/documents/devices/$(request.resource.data.deviceId)).data.ownerUid == request.auth.uid &&
        (request.resource.data.userUid == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.resource.data.userUid)).data.ownerAdminUid == request.auth.uid);
      // Assignment identity and role are immutable. Reassigning requires the
      // owner to remove the old relationship then explicitly create a new one.
      allow update: if false;
      allow delete: if isAdmin() &&
        get(/databases/$(database)/documents/devices/$(resource.data.deviceId)).data.ownerUid == request.auth.uid &&
        (resource.data.userUid == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(resource.data.userUid)).data.ownerAdminUid == request.auth.uid);
    }

    // LOGS and NOTIFICATIONS (Top-level or nested)
    match /parameter_logs/{logId} {
       allow read: if isSignedIn() && (isAdmin() || isAssignedToDevice(resource.data.deviceId));
       allow write: if false; // Only written by IoT devices/cloud functions
    }

    match /notifications/{notifId} {
       allow read: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
       allow write: if isAdmin();
    }
  }
}
