<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <include layout="@layout/layout_header" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/container_overlap_margin"
        android:background="@drawable/top_rounded_white"
        android:elevation="5dp"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingStart="@dimen/container_side_padding"
            android:paddingEnd="@dimen/container_side_padding"
            android:paddingBottom="88dp">

            <!-- PAGE HEADER: title/subtitle centred on their own lines, with
                 the export action on a separate row below so it can never
                 crowd or off-centre the title. Harvest has no info/help
                 entry point today, so none is invented here. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/ds_space_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.PageTitle"
                    android:gravity="center"
                    android:text="Harvest Report" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.PageSubtitle"
                    android:layout_marginTop="@dimen/ds_space_xs"
                    android:gravity="center"
                    android:text="Production for this cultivation cycle" />

            </LinearLayout>

            <!-- CYCLE CONTEXT ROW: cycle identity and status on the left,
                 export aligned with it on the right, date range beneath.
                 Typography and alignment only - no extra surface. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCycleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.SectionTitle"
                    android:text="Cycle #1" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/status_chip_bg"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="ACTIVE"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportPdf"
                    style="@style/Basilience.HeaderIconButton"
                    android:text=""
                    android:visibility="gone"
                    android:contentDescription="Export report"
                    app:icon="@drawable/ic_share"
                    app:iconSize="22dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCycleRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Basilience.Caption"
                android:text="" />

            <!-- Cycle-level action, kept with the cycle context it acts on
                 rather than trailing the report's conclusion. The
                 confirmation dialog is what guards the action. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCompleteCycle"
                style="@style/BasilienceButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_md"
                android:text="Complete Cycle"
                android:visibility="gone" />

            <!-- PRODUCTION HERO: the two headline production figures share
                 the surface so neither side sits empty. The entry count
                 lives here only - it is not repeated under the weight. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_md"
                android:orientation="horizontal"
                android:background="@drawable/ds_surface_hero_bg"
                android:padding="@dimen/ds_surface_padding">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="6"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.SectionLabel"
                        android:text="Total Harvested" />

                    <TextView
                        android:id="@+id/tvTotalWeight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 g"
                        android:textColor="@color/primary"
                        android:textSize="30sp"
                        android:fontFamily="sans-serif-black" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/ds_space_sm"
                    android:background="@color/ds_divider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="4"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.SectionLabel"
                        android:text="Harvest Entries" />

                    <TextView
                        android:id="@+id/tvHarvestCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0"
                        android:textColor="@color/text_dark"
                        android:textSize="30sp"
                        android:fontFamily="sans-serif-black" />
                </LinearLayout>
            </LinearLayout>

            <!-- SCHEDULE COMPONENT: the lightest surface on the page, so it
                 bridges the hero and the chart without competing with
                 either. Date carries the value role; frequency and its edit
                 pencil are grouped together on the trailing side so the
                 pencil never reads as detached from what it edits. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_md"
                android:orientation="vertical"
                android:background="@drawable/ds_surface_interpretation_bg"
                android:paddingHorizontal="@dimen/ds_surface_padding"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/tvNextHarvestLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.SectionLabel"
                    android:text="Next Harvest" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvExpectedDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="19sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_dark"
                        android:text="--" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:minWidth="12dp" />

                    <TextView
                        android:id="@+id/tvFrequency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.Caption"
                        android:text="" />

                    <ImageView
                        android:id="@+id/btnEditFrequency"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="7dp"
                        android:layout_marginStart="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_edit"
                        android:contentDescription="Edit harvest frequency"
                        android:visibility="gone"
                        app:tint="@color/primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- ACCUMULATED HARVEST CHART SURFACE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_lg"
                android:orientation="vertical"
                android:background="@drawable/ds_surface_chart_bg"
                android:padding="@dimen/ds_surface_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.SectionTitle"
                    android:text="Accumulated Harvest" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.Caption"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="@dimen/ds_space_md"
                    android:text="Total harvested weight over this cycle" />

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/harvestChart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ds_chart_height" />

                <TextView
                    android:id="@+id/tvEmptyChart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.BodyMuted"
                    android:gravity="center"
                    android:paddingVertical="48dp"
                    android:text="No harvest has been recorded for this cycle yet."
                    android:visibility="gone" />
            </LinearLayout>

            <!-- HARVEST HISTORY -->
            <View
                style="@style/Basilience.Divider"
                android:layout_marginTop="@dimen/ds_space_xl"
                android:layout_marginBottom="@dimen/ds_space_md" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Basilience.SectionTitle"
                android:text="Harvest History"
                android:layout_marginBottom="@dimen/ds_space_xs" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerHarvest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvEmptyHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Basilience.BodyMuted"
                android:gravity="center"
                android:padding="24dp"
                android:text="No harvest has been recorded for this cycle yet."
                android:visibility="gone" />

            <!-- WHAT THIS MEANS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_xl"
                android:orientation="vertical"
                android:background="@drawable/ds_surface_interpretation_bg"
                android:padding="@dimen/ds_surface_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.SectionTitle"
                    android:text="What This Means"
                    android:layout_marginBottom="@dimen/ds_space_sm" />

                <TextView
                    android:id="@+id/tvHarvestInterpretation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.BodyMuted"
                    android:text="No harvest has been recorded for this cycle yet." />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddHarvest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="Add harvest"
        android:visibility="gone"
        app:backgroundTint="@color/primary"
        app:elevation="6dp"
        app:pressedTranslationZ="10dp"
        app:tint="@android:color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
