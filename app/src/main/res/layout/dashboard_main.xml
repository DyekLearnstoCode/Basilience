<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Shared header used but back button is hidden on main dashboard -->
            <include layout="@layout/layout_header" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/container_overlap_margin"
        android:background="@drawable/top_rounded_white"
        android:elevation="5dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/container_side_padding"
            android:paddingTop="@dimen/container_top_padding"
            android:paddingEnd="@dimen/container_side_padding"
            android:paddingBottom="@dimen/container_side_padding">

            <!-- TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="-0.02"
                android:text="@string/dashboard"
                android:textColor="@color/state_primary_text"
                android:textSize="28sp" />

            <!-- DEVICE STATUS (reuses DeviceConnectionManager's existing state;
                 hidden when no device is selected) -->
            <TextView
                android:id="@+id/tvDashboardDeviceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="Checking Status..."
                android:textColor="@color/device_status_reconnecting"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- NO ACTIVE GROWTH CYCLE
                 Hidden until the cycles have actually been read, so the app
                 never flashes this while still loading or after a read error. -->
            <LinearLayout
                android:id="@+id/cardNoActiveCycle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_option"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvNoCycleTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No Active Growth Cycle"
                    android:textColor="@color/state_primary_text"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvNoCycleBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Create a growth cycle to begin cultivation automation."
                    android:textColor="@color/nav_inactive"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDashboardCreateCycle"
                    style="@style/BasilienceButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Create Cycle"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- PARAMETERS MONITORING -->
            <LinearLayout
                android:id="@+id/cardParameters"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_option"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <!-- ICON -->
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="0dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_parameters_monitoring" />

                <!-- TEXT -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/parameters_monitoring"
                    style="@style/Basilience.CardOptionLabel" />

                <!-- CIRCLE BUTTON -->
                <FrameLayout
                    android:id="@+id/btnParameters"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/circle_button"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:src="@drawable/enter_arrow" />

                </FrameLayout>

            </LinearLayout>

            <!-- USER GUIDE -->
            <LinearLayout
                android:id="@+id/cardUserGuide"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_option"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <!-- ICON -->
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="0dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_user_guide" />

                <!-- TEXT -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/feature2"
                    style="@style/Basilience.CardOptionLabel" />

                <!-- CIRCLE BUTTON -->
                <FrameLayout
                    android:id="@+id/btnUserGuide"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/circle_button"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:src="@drawable/enter_arrow" />

                </FrameLayout>

            </LinearLayout>

            <!-- CYCLE DETAILS -->
            <LinearLayout
                android:id="@+id/cardCycle"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_option"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <!-- ICON -->
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="0dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_cycle_details" />

                <!-- TEXT -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/feature4"
                    style="@style/Basilience.CardOptionLabel" />

                <!-- CIRCLE BUTTON -->
                <FrameLayout
                    android:id="@+id/btnCycle"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/circle_button"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:src="@drawable/enter_arrow" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>