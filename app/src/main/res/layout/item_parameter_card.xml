<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="110dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    app:cardUseCompatPadding="true"
    app:strokeWidth="0dp"
    app:strokeColor="@android:color/transparent"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ICON + LABEL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/tvLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="pH"
                android:textSize="13sp"
                android:textColor="@color/state_primary_text"/>
        </LinearLayout>

        <!-- VALUE -->
        <TextView
            android:id="@+id/tvValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/state_primary_text"
            android:layout_marginTop="8dp"/>

        <!-- STATE (Normal / Warning / No Data) - text, not color alone -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/state_no_data"
            android:layout_marginTop="2dp"/>

        <!-- STABILIZING LOADER - shown instead of tvValue/tvStatus above
             while the reading is known to be untrustworthy (actively dosing,
             or still in the initial settle window after a correction). See
             Parameters_Monitoring_Fragment's updateStabilizingLoader(). -->
        <FrameLayout
            android:id="@+id/stabilizingLoader"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressStabilizing"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:indicatorSize="36dp"
                app:trackThickness="3dp"
                app:indicatorColor="@color/primary" />

            <TextView
                android:id="@+id/tvStabilizeSeconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="--"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/state_primary_text"/>

        </FrameLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
