<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/celadon"> <!-- ADD THIS LINE HERE -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- NavHostFragment points to nav_graph -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        android:background="@android:color/transparent" /> <!-- Ensure fragments are transparent -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:paddingBottomSystemWindowInsets="true"
        app:elevation="8dp" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/activeAlertBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="12dp"
        android:elevation="20dp"
        android:translationY="-300dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/alert_red"
        app:cardCornerRadius="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/alertTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE ALERT"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/alert_text" />

            <TextView
                android:id="@+id/alertMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/alert_text"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- CONFIRMED BUG FIX (loading overlay not covering bottom nav): every
         per-fragment "full screen" loading overlay (e.g. parameters_monitoring.xml's
         actuatorLoadingOverlay/sensorStabilizingOverlay, reports_fogging.xml's
         layoutLoading, etc.) lives inside that fragment's own root view, which
         nav_host_fragment above bounds to the space ABOVE this BottomNavigationView
         (height="0dp" + layout_weight="1") - so those overlays can visually dim
         their own screen's content but can never reach the nav bar, which sits in a
         separate, non-overlapping sibling area and stayed fully bright/interactive
         during "loading". This Activity-level view sits above both of them in the
         same root FrameLayout and is toggled by MainActivity.setGlobalDimOverlayVisible()
         alongside each fragment's own local overlay, so taps on the nav bar are
         blocked for the same duration as the rest of the screen.

         CONFIRMED BUG FIX (overlay painting over dialogs/loaders): this view used
         to also carry a visible #99000000 tint (android:background), covering the
         WHOLE screen. Because it sits above nav_host_fragment's entire subtree, that
         tint painted a second time over every fragment's own popup/loader content
         too - e.g. Parameters Monitoring's actuatorLoadingOverlay/
         sensorStabilizingOverlay card (a plain white MaterialCardView per
         Basilience.LoadingOverlayCard) rendered washed-out grey instead of crisp
         white, because this scrim darkened it a second time on top of the
         fragment's own, correctly-scoped dim. This view is now fully transparent -
         it exists purely to intercept touches over the whole screen (including the
         nav bar, which fragments can't reach) while something is loading. The nav
         bar's own visible dimming now comes from a foreground scrim MainActivity
         toggles directly on bottom_navigation (see setGlobalDimOverlayVisible()),
         which is bounded to exactly that view's own rectangle and can never bleed
         into nav_host_fragment's area. -->
    <View
        android:id="@+id/globalDimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:elevation="24dp"
        android:visibility="gone" />

</FrameLayout>