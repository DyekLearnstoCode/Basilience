<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include layout="@layout/layout_header" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/container_overlap_margin"
        android:background="@drawable/top_rounded_white"
        android:elevation="5dp"
        android:overScrollMode="never"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/container_top_padding"
            android:paddingStart="@dimen/container_side_padding"
            android:paddingEnd="@dimen/container_side_padding"
            android:paddingBottom="@dimen/container_side_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="User Guide"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02"
                
                android:textColor="@color/state_primary_text"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- HARDWARE CARD -->
            <LinearLayout
                android:id="@+id/cardHardware"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/input_card"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/primary" >

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="3dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_hardware_guide"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hardware Tutorial"
                    android:textSize="18sp"
                    android:layout_marginTop="10dp"
                    android:textAlignment="center"
                    
                    android:textColor="@color/state_primary_text"/>

                <FrameLayout
                    android:id="@+id/btnHardwareTutorial"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/circle_button"
                    android:layout_marginTop="10dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/enter_arrow"
                        android:layout_gravity="center"
                        app:tint="@color/state_primary_text"/>
                </FrameLayout>
            </LinearLayout>

            <!-- MOBILE CARD -->
            <LinearLayout
                android:id="@+id/cardMobile"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/input_card"
                android:orientation="vertical"
                android:gravity="center"
                android:backgroundTint="@color/primary"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_mobile_app_guide"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Mobile App Tutorial"
                    android:textAlignment="center"
                    android:textSize="18sp"
                    
                    android:textColor="@color/state_primary_text"/>

                <FrameLayout
                    android:id="@+id/btnMobileTutorial"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/circle_button"
                    android:layout_marginTop="10dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/enter_arrow"
                        android:layout_gravity="center"
                        app:tint="@color/state_primary_text"/>
                </FrameLayout>
            </LinearLayout>

            <!-- APP WALKTHROUGH: deliberately a slim secondary action, not a
                 third big teal card - it's a short replay of first-install
                 onboarding, not another detailed guide, so it shouldn't
                 compete visually with Hardware/Mobile Tutorial above. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAppWalkthrough"
                style="@style/BasilienceButton.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="View App Walkthrough"
                app:icon="@android:drawable/ic_menu_recent_history"
                app:iconTint="@color/primary"
                app:iconGravity="textStart" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
