<?xml version="1.0" encoding="utf-8"?>
<!-- Tap marker for the Parameter Report trend chart. Compact white surface
     with a thin neutral border; shows the tapped point's timestamp above
     its formatted value. Purely presentational - the values it renders come
     straight from the entry already plotted. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/ds_marker_bg"
    android:paddingHorizontal="10dp"
    android:paddingVertical="7dp">

    <TextView
        android:id="@+id/tvMarkerTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/nav_inactive"
        android:fontFamily="sans-serif"
        android:text="" />

    <TextView
        android:id="@+id/tvMarkerValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textSize="14sp"
        android:textColor="@color/text_dark"
        android:fontFamily="sans-serif-medium"
        android:text="" />

</LinearLayout>
