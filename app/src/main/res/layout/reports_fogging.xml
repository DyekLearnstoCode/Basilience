<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <include layout="@layout/layout_header" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/container_overlap_margin"
        android:background="@drawable/top_rounded_white"
        android:elevation="5dp"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingStart="@dimen/container_side_padding"
            android:paddingEnd="@dimen/container_side_padding"
            android:paddingBottom="@dimen/ds_space_xl">

            <!-- PAGE HEADER: title/subtitle centred on their own lines, with
                 the actions on a separate row below so they can never crowd
                 or off-centre the title. Same structure as Parameter Report. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/ds_space_lg">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.PageTitle"
                    android:gravity="center"
                    android:text="Fogging Report" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.PageSubtitle"
                    android:layout_marginTop="@dimen/ds_space_xs"
                    android:gravity="center"
                    android:text="When the fogger ran, how often, and for how long during the selected cycle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end|center_vertical"
                    android:layout_marginTop="@dimen/ds_space_sm">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShare"
                        style="@style/Basilience.HeaderIconButton"
                        android:text=""
                        android:contentDescription="Export report"
                        app:icon="@drawable/ic_share"
                        app:iconSize="22dp" />

                    <ImageButton
                        android:id="@+id/btnInfo"
                        android:layout_width="@dimen/ds_header_icon_size"
                        android:layout_height="@dimen/ds_header_icon_size"
                        android:padding="9dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_info_outline"
                        android:tint="@color/nav_inactive"
                        android:contentDescription="How Fogging Reports work" />
                </LinearLayout>
            </LinearLayout>

            <!-- NO CYCLES EMPTY STATE -->
            <LinearLayout
                android:id="@+id/noCyclesEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="48dp"
                android:paddingBottom="48dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvNoCyclesEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="No cultivation cycles exist for this device yet."
                    android:textColor="@color/nav_inactive"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- REPORT CONTENT -->
            <LinearLayout
                android:id="@+id/reportContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- CYCLE SELECTOR: flat context row, divider as its only edge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.SectionLabel"
                    android:text="Cultivation Cycle"
                    android:layout_marginBottom="@dimen/ds_space_xs" />

                <Spinner
                    android:id="@+id/spinnerCycle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ds_selector_height"
                    android:paddingStart="0dp"
                    android:paddingEnd="32dp"
                    android:background="@drawable/ds_selector_bg_flat"
                    android:theme="@style/ThemeOverlay.AppCompat.Light" />

                <View style="@style/Basilience.Divider" />

                <!-- PERIOD FILTER: one segmented-control track -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.SectionLabel"
                    android:text="Period"
                    android:layout_marginTop="@dimen/ds_space_lg"
                    android:layout_marginBottom="@dimen/ds_space_xs" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/ds_segment_track_bg"
                    android:padding="3dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEntireCycle"
                        style="@style/Basilience.SegmentChip.Selected"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Entire"
                        android:layout_marginEnd="2dp"
                        android:padding="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToday"
                        style="@style/Basilience.SegmentChip"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Today"
                        android:layout_marginEnd="2dp"
                        android:padding="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWeek"
                        style="@style/Basilience.SegmentChip"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="7D"
                        android:layout_marginEnd="2dp"
                        android:padding="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonth"
                        style="@style/Basilience.SegmentChip"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="30D"
                        android:layout_marginEnd="2dp"
                        android:padding="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCustom"
                        style="@style/Basilience.SegmentChip"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Custom"
                        android:padding="0dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEffectiveRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    style="@style/Basilience.Caption"
                    android:layout_marginTop="@dimen/ds_space_md"
                    android:text="" />

                <!-- INSIGHT HERO -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardInsightHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_lg"
                    app:cardCornerRadius="@dimen/ds_surface_radius"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/ds_hero_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/heroAccentEdge"
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:background="@color/ds_divider" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/ds_surface_padding">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <View
                                    android:id="@+id/dotFoggingStatus"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_marginEnd="8dp"
                                    android:background="@drawable/ds_dot" />

                                <TextView
                                    android:id="@+id/tvFoggingStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/Basilience.StatusBadge"
                                    android:text="SELECT A CYCLE"
                                    android:textColor="@color/nav_inactive"
                                    android:background="@drawable/ds_status_pill_neutral"
                                    android:paddingHorizontal="14dp"
                                    android:paddingVertical="6dp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvSessionBreakdown"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                style="@style/Basilience.BodyMuted"
                                android:layout_marginTop="@dimen/ds_space_md"
                                android:text="" />

                            <!-- Automatic/manual split, shown only once a
                                 report with sessions has loaded. -->
                            <LinearLayout
                                android:id="@+id/heroControlBlock"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <View
                                    style="@style/Basilience.Divider"
                                    android:layout_marginTop="@dimen/ds_space_sm"
                                    android:layout_marginBottom="@dimen/ds_space_sm" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_weight="1"
                                        android:layout_height="wrap_content"
                                        style="@style/Basilience.BodyMuted"
                                        android:text="Automatic" />

                                    <TextView
                                        android:id="@+id/tvHeroAutoCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        style="@style/Basilience.HeroValue"
                                        android:text="--" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:layout_marginTop="6dp">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_weight="1"
                                        android:layout_height="wrap_content"
                                        style="@style/Basilience.BodyMuted"
                                        android:text="Manual" />

                                    <TextView
                                        android:id="@+id/tvHeroManualCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        style="@style/Basilience.HeroValue"
                                        android:text="--" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KEY METRICS -->
                <LinearLayout
                    android:id="@+id/statsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_lg"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvEventCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Basilience.MetricValue"
                            android:text="--" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Basilience.MetricLabel"
                            android:layout_marginTop="2dp"
                            android:text="Fogging Sessions" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:background="@color/ds_divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvTotalDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Basilience.MetricValue"
                            android:text="--" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Basilience.MetricLabel"
                            android:layout_marginTop="2dp"
                            android:text="Total Fogging Time" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:background="@color/ds_divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvAvgDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Basilience.MetricValue"
                            android:text="--" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Basilience.MetricLabel"
                            android:layout_marginTop="2dp"
                            android:text="Average Session" />
                    </LinearLayout>
                </LinearLayout>

                <!-- DAILY FOGGING RUNTIME CHART SURFACE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_xl"
                    android:orientation="vertical"
                    android:background="@drawable/ds_surface_chart_bg"
                    android:padding="@dimen/ds_surface_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.SectionTitle"
                        android:text="Fogging Time Per Day" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.Caption"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="@dimen/ds_space_md"
                        android:text="Fogging time across the selected period" />

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/barChart"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ds_chart_height" />
                </LinearLayout>

                <!-- FOGGING CONTROL: runtime split by how it was started -->
                <View
                    style="@style/Basilience.Divider"
                    android:layout_marginTop="@dimen/ds_space_xl"
                    android:layout_marginBottom="@dimen/ds_space_md" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.SectionTitle"
                    android:text="Fogging Control"
                    android:layout_marginBottom="@dimen/ds_space_sm" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.BodyMuted"
                        android:text="Automatic" />

                    <TextView
                        android:id="@+id/tvBreakdownAuto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.HeroValue"
                        android:text="--" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.BodyMuted"
                        android:text="Manual" />

                    <TextView
                        android:id="@+id/tvBreakdownManual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.HeroValue"
                        android:text="--" />
                </LinearLayout>

                <!-- FOGGING STRATEGY: rows are added at runtime, and only for
                     strategies that actually appear in the processed data. -->
                <LinearLayout
                    android:id="@+id/strategySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/ds_space_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.SectionTitle"
                        android:text="Fogging Strategy"
                        android:layout_marginBottom="@dimen/ds_space_sm" />

                    <LinearLayout
                        android:id="@+id/strategyRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tvBreakdownAutoDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.BodyMuted"
                        android:text="No strategy details"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- WATER OUTLOOK - independent, current/predictive, kept
                     visually distinct with a dedicated tint so it never
                     reads as another statistic of the report period above. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_xl"
                    android:orientation="vertical"
                    android:background="@drawable/ds_surface_water_bg"
                    android:padding="@dimen/ds_surface_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.SectionTitle"
                        android:text="Water Outlook" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.Caption"
                        android:layout_marginTop="2dp"
                        android:text="Rough estimate from typical use" />

                    <LinearLayout
                        android:id="@+id/waterOutlookValues"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_md"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/waterLevelColumn"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvWaterLevel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="20sp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/text_dark"
                                android:text="--" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/Basilience.MetricLabel"
                                android:layout_marginTop="2dp"
                                android:text="Reservoir" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/refillColumn"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvRefillTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="20sp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/text_dark"
                                android:text="--" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/Basilience.MetricLabel"
                                android:layout_marginTop="2dp"
                                android:text="Estimated refill" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Used for the outdated/insufficient states, where a
                         big numeric value would be misleading. -->
                    <TextView
                        android:id="@+id/tvWaterOutlookMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.BodyMuted"
                        android:layout_marginTop="@dimen/ds_space_sm"
                        android:text=""
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvRefillThreshold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.Caption"
                        android:layout_marginTop="@dimen/ds_space_sm"
                        android:text="Refill threshold: -" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.Caption"
                        android:layout_marginTop="2dp"
                        android:text="Based on recent 7-day fogging activity. Independent of the report period above." />
                </LinearLayout>

                <!-- RECENT FOGGING ACTIVITY -->
                <View
                    style="@style/Basilience.Divider"
                    android:layout_marginTop="@dimen/ds_space_xl"
                    android:layout_marginBottom="@dimen/ds_space_md" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.SectionTitle"
                    android:text="Recent Fogging Activity"
                    android:layout_marginBottom="@dimen/ds_space_xs" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecentActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/tvEmptyActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.BodyMuted"
                    android:text="No recent activity"
                    android:gravity="center"
                    android:padding="24dp"
                    android:visibility="gone" />

                <!-- WHAT THIS MEANS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_xl"
                    android:orientation="vertical"
                    android:background="@drawable/ds_surface_interpretation_bg"
                    android:padding="@dimen/ds_surface_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.SectionTitle"
                        android:text="What This Means"
                        android:layout_marginBottom="@dimen/ds_space_sm" />

                    <TextView
                        android:id="@+id/tvFoggingInterpretation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.BodyMuted"
                        android:text="Select a cycle to view a report." />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- LOADING OVERLAY -->
    <RelativeLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            style="@style/Basilience.LoadingOverlayCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">

            <LinearLayout
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp">

                <ProgressBar
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:indeterminateTint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Loading report..."
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
