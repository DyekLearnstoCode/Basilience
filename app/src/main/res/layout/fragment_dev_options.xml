<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <include layout="@layout/layout_header" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/container_overlap_margin"
        android:background="@drawable/top_rounded_white"
        android:elevation="5dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/container_top_padding"
            android:paddingStart="@dimen/container_side_padding"
            android:paddingEnd="@dimen/container_side_padding"
            android:paddingBottom="32dp">

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Developer Tools"
                android:textColor="#212121"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Configure developer options, simulation data, and Wi-Fi settings."
                android:textColor="#757575"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />

            <!-- FILTER CHIPS BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterSensorTest"
                    style="@style/DeveloperFilterChip"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="Sensor Test"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterMock"
                    style="@style/DeveloperFilterChip"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:iconPadding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="Mock Data"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterRefill"
                    style="@style/DeveloperFilterChip"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:iconPadding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="Water Refill"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterWifi"
                    style="@style/DeveloperFilterChip"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:iconPadding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="Wi-Fi Config"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 1. PHYSICAL SENSOR TEST CONTAINER -->
            <LinearLayout
                android:id="@+id/containerSensorTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Physical Sensor Test"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="#212121"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Reads actual ESP32 hardware sensors while automatic cultivation control is paused."
                            android:textColor="#757575"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvSensorTestIndicator"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:padding="10dp"
                            android:text="SENSOR TEST INACTIVE"
                            android:textColor="@color/state_off"
                            android:textStyle="bold" />

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:columnCount="2"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvDiagnosticPh"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="4dp"
                                android:background="@drawable/card_option"
                                android:gravity="center"
                                android:padding="12dp"
                                android:text="pH\n--\nNO VALID READING"
                                android:textColor="@color/sensor_no_data" />

                            <TextView
                                android:id="@+id/tvDiagnosticEc"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="4dp"
                                android:background="@drawable/card_option"
                                android:gravity="center"
                                android:padding="12dp"
                                android:text="EC\n--\nNO VALID READING"
                                android:textColor="@color/sensor_no_data" />

                            <TextView
                                android:id="@+id/tvDiagnosticAirTemperature"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="4dp"
                                android:background="@drawable/card_option"
                                android:gravity="center"
                                android:padding="12dp"
                                android:text="Air Temperature\n--\nNO VALID READING"
                                android:textColor="@color/sensor_no_data" />

                            <TextView
                                android:id="@+id/tvDiagnosticHumidity"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="4dp"
                                android:background="@drawable/card_option"
                                android:gravity="center"
                                android:padding="12dp"
                                android:text="Humidity\n--\nNO VALID READING"
                                android:textColor="@color/sensor_no_data" />

                            <TextView
                                android:id="@+id/tvDiagnosticWaterTemperature"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="4dp"
                                android:background="@drawable/card_option"
                                android:gravity="center"
                                android:padding="12dp"
                                android:text="Water Temperature\n--\nNO VALID READING"
                                android:textColor="@color/sensor_no_data" />

                            <TextView
                                android:id="@+id/tvDiagnosticWaterLevel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="4dp"
                                android:background="@drawable/card_option"
                                android:gravity="center"
                                android:padding="12dp"
                                android:text="Water Level\n--\nNO VALID READING"
                                android:textColor="@color/sensor_no_data" />

                            <TextView
                                android:id="@+id/tvDiagnosticWaterLevelDistance"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="4dp"
                                android:background="@drawable/card_option"
                                android:gravity="center"
                                android:padding="12dp"
                                android:text="Water Level Distance\n--\nNO VALID READING"
                                android:textColor="@color/sensor_no_data" />
                        </GridLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSensorTest"
                            style="@style/BasilienceButton.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="16dp"
                            android:text="Start Sensor Test"
                            android:textStyle="bold"
                            app:cornerRadius="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 2. MOCK DATA CONTAINER -->
            <LinearLayout
                android:id="@+id/containerMockData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Mock Sensors Simulation"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="#212121"
                                android:textSize="18sp"/>

                        </LinearLayout>

                        <!-- Enable Mocking Toggle Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/card_option"
                            android:padding="14dp"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="20dp">
                            
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Enable Mock Data Override"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="15sp"
                                android:textColor="#212121" />

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switchMockEnable"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:thumbTint="@color/switch_thumb_tint"
                                android:trackTint="@color/switch_track_tint" />
                        </LinearLayout>

                        <!-- Input Fields -->
                        <!-- pH -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/InputFieldStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPh"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="pH Level (e.g. 6.0)"
                                android:inputType="numberDecimal"
                                android:textColor="@android:color/black"
                                android:textCursorDrawable="@null" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- EC -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/InputFieldStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="EC mS/cm (e.g. 1.5)"
                                android:inputType="numberDecimal"
                                android:textColor="@android:color/black"
                                android:textCursorDrawable="@null" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Air Temp -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/InputFieldStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTemp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Air Temperature °C (e.g. 24.5)"
                                android:inputType="numberDecimal"
                                android:textColor="@android:color/black"
                                android:textCursorDrawable="@null" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Humidity -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/InputFieldStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etHumidity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Humidity % (e.g. 60.0)"
                                android:inputType="numberDecimal"
                                android:textColor="@android:color/black"
                                android:textCursorDrawable="@null" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Water Level -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/InputFieldStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etWaterTemperature"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Water Temperature °C (e.g. 22.0)"
                                android:inputType="numberDecimal"
                                android:textColor="@android:color/black"
                                android:textCursorDrawable="@null" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Water Level -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/InputFieldStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etWaterLevel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Water Level % (e.g. 75.0)"
                                android:inputType="numberDecimal"
                                android:textColor="@android:color/black"
                                android:textCursorDrawable="@null" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Push Mock Data Button -->
                        <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPush"
                    style="@style/BasilienceButton.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="Push Mock Values to ESP32"
                            app:cornerRadius="12dp"
                            app:backgroundTint="@color/primary"
                            android:textColor="@color/onPrimary"
                            android:layout_marginBottom="12dp"
                            android:textStyle="bold"/>

                        <!-- Inject Logs Button -->
                        <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInjectLogs"
                    style="@style/BasilienceButton.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="Inject Firestore Mock Logs"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/primary"
                            app:strokeWidth="1.5dp"
                            android:textColor="@color/primary"
                            android:textStyle="bold"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 2. WATER REFILL CONTAINER -->
            <LinearLayout
                android:id="@+id/containerRefillLevels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Water Refill Thresholds"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="#212121"
                            android:textSize="18sp"
                            android:layout_marginBottom="16dp"/>

                        <!-- Min Water Level -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/InputFieldStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etMinWaterLevel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Min Water Level % - Refill Start"
                                android:inputType="numberDecimal"
                                android:textColor="@android:color/black"
                                android:textCursorDrawable="@null" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Max Water Level -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/InputFieldStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etMaxWaterLevel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Max Water Level % - Refill Stop"
                                android:inputType="numberDecimal"
                                android:textColor="@android:color/black"
                                android:textCursorDrawable="@null" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Push Settings Button -->
                        <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPushSettings"
                    style="@style/BasilienceButton.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="Push Refill Thresholds to ESP32"
                            app:cornerRadius="12dp"
                            app:backgroundTint="@color/primary"
                            android:textColor="@color/onPrimary"
                            android:textStyle="bold"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 3. WI-FI CONFIG CONTAINER -->
            <LinearLayout
                android:id="@+id/containerWifiConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wi-Fi Configuration"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="#212121"
                            android:textSize="18sp"
                            android:layout_marginBottom="8dp"/>

                        <!-- Wi-Fi Connection Status -->
                        <TextView
                            android:id="@+id/tvWifiStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Checking status..."
                            android:textColor="#757575"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="16dp"/>

                        <!-- SSID Input -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/InputFieldStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSsid"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Wi-Fi SSID / Network Name"
                                android:inputType="textNoSuggestions"
                                android:textColor="@android:color/black"
                                android:textCursorDrawable="@null" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Password Input -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/InputFieldStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            app:passwordToggleEnabled="true">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Wi-Fi Password"
                                android:inputType="textPassword"
                                android:textColor="@android:color/black"
                                android:textCursorDrawable="@null" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Push Wi-Fi Config Button -->
                        <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPushWifi"
                    style="@style/BasilienceButton.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="Send Wi-Fi Config Locally"
                            app:cornerRadius="12dp"
                            app:backgroundTint="@color/primary"
                            android:textColor="@color/onPrimary"
                            android:textStyle="bold"/>

                        <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnableProvisioningAp"
                    style="@style/BasilienceButton.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="12dp"
                            android:text="Enable Provisioning/AP Mode"
                            android:textStyle="bold"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDisableDeveloperMode"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="4dp"
                    android:text="Disable Developer Mode"
                    android:textColor="#757575"
                    app:cornerRadius="12dp"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- LOADING OVERLAY -->
    <RelativeLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:cardCornerRadius="20dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp">

                <ProgressBar
                    android:id="@+id/loadingProgressBar"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:indeterminateTint="@color/primary" />

                <TextView
                    android:id="@+id/tvLoadingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Pushing to ESP32..."
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tvLoadingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Updating Database..."
                    android:textColor="#757575"
                    android:textSize="12sp"
                    android:gravity="center"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
