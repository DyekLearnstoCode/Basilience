<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <include layout="@layout/layout_header" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/top_rounded_white"
        android:elevation="5dp"
        android:fillViewport="true"
        android:layout_marginTop="@dimen/container_overlap_margin"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/container_top_padding"
            android:paddingStart="@dimen/container_side_padding"
            android:paddingEnd="@dimen/container_side_padding"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="About Basilience"
                android:textColor="@color/state_primary_text"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02" />

            <!-- WHAT BASILIENCE IS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="Basilience is an IoT-enabled cultivation system designed to support Genovese basil production using fogponics. It connects your growing equipment to this app so you can monitor and manage your farm from your phone."
                android:textColor="#333333"
                android:textSize="16sp" />

            <!-- WHAT THE SYSTEM DOES -->
            <TextView
                style="@style/Basilience.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="What It Does" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"
                android:textColor="#333333"
                android:textSize="14.5sp"
                android:text="●  Monitors growing conditions in real time\n●  Manages automated cultivation equipment\n●  Tracks growth cycles from start to harvest\n●  Records harvests\n●  Sends alerts when something needs your attention\n●  Provides historical reports\n●  Supports assigned farm personnel" />

            <!-- MONITORED PARAMETERS -->
            <TextView
                style="@style/Basilience.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="What It Monitors" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"
                android:textColor="#333333"
                android:textSize="14.5sp"
                android:text="●  pH\n●  Nutrient concentration (EC)\n●  Air temperature\n●  Humidity\n●  Water temperature\n●  Reservoir water level" />

            <!-- AUTOMATION -->
            <TextView
                style="@style/Basilience.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="Automation" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="#333333"
                android:textSize="14.5sp"
                android:text="Automated cultivation runs while a growth cycle is active, keeping conditions within your target ranges. When no cycle is active, normal cultivation automation is paused, but monitoring and safety functions remain available." />

            <!-- OFFLINE BEHAVIOR -->
            <TextView
                style="@style/Basilience.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="Staying Connected" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="#333333"
                android:textSize="14.5sp"
                android:text="The cultivation device is designed to continue essential local automation during a temporary connection loss." />

            <View
                style="@style/Basilience.Divider"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp" />

            <!-- PROJECT INFORMATION: subordinate to the operational content
                 above - smaller, muted, no card - so About still reads as a
                 user-facing screen rather than a research abstract. -->
            <TextView
                style="@style/Basilience.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="PROJECT INFORMATION" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/nav_inactive"
                android:textSize="12.5sp"
                android:textStyle="italic"
                android:text="Basilience was developed as the project &quot;Basilience: An IoT-Android Based Fogponics Cultivation System for Genovese Basil Using Ultrasonic Atomization for Girasoles Farm Candelaria.&quot;" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Version 1.0.0"
                android:textColor="#777777"
                android:textSize="13sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
