<?xml version="1.0" encoding="utf-8"?>
<!-- Scrollable guide/help dialog. Body content is built at runtime into
     guideSections as left-aligned heading/body pairs; the ScrollView is
     capped to a share of screen height so the Close action always stays
     reachable on short phones. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white"
    app:strokeColor="@color/celadon"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/guideTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textAlignment="center" />

        <View
            style="@style/Basilience.Divider"
            android:layout_marginTop="14dp" />

        <ScrollView
            android:id="@+id/guideScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:paddingTop="14dp"
            android:paddingBottom="4dp"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/guideSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <View
            style="@style/Basilience.Divider"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/guideClose"
            style="@style/BasilienceButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Got It"
            android:backgroundTint="@color/primary"
            android:textColor="@color/onPrimary"
            app:cornerRadius="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
