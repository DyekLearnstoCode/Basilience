<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <include layout="@layout/layout_header" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/container_overlap_margin"
        android:background="@drawable/top_rounded_white"
        android:elevation="5dp"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingStart="@dimen/container_side_padding"
            android:paddingEnd="@dimen/container_side_padding"
            android:paddingBottom="@dimen/ds_space_xl">

            <!-- PAGE HEADER (V2): title/subtitle centered on their own
                 lines; export/info actions live on a separate row below,
                 right-aligned, so they never sit beside the title text and
                 can never pull its true center off-balance. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/ds_space_lg">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.PageTitle"
                    android:gravity="center"
                    android:text="Parameter Report" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.PageSubtitle"
                    android:layout_marginTop="@dimen/ds_space_xs"
                    android:gravity="center"
                    android:text="Cultivation conditions for the selected cycle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end|center_vertical"
                    android:layout_marginTop="@dimen/ds_space_sm">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShare"
                        style="@style/Basilience.HeaderIconButton"
                        android:text=""
                        android:contentDescription="Export report"
                        app:icon="@drawable/ic_share"
                        app:iconSize="22dp" />

                    <ImageButton
                        android:id="@+id/btnInfo"
                        android:layout_width="@dimen/ds_header_icon_size"
                        android:layout_height="@dimen/ds_header_icon_size"
                        android:padding="9dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_info_outline"
                        android:tint="@color/nav_inactive"
                        android:contentDescription="How Parameter Reports work" />
                </LinearLayout>
            </LinearLayout>

            <!-- NO CYCLES EMPTY STATE -->
            <LinearLayout
                android:id="@+id/noCyclesEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="48dp"
                android:paddingBottom="48dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvNoCyclesEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="No cultivation cycles exist for this device yet."
                    android:textColor="@color/nav_inactive"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- REPORT CONTENT -->
            <LinearLayout
                android:id="@+id/reportContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- CYCLE SELECTOR: flat context row, no boxed outline - a
                     bottom divider is the row's only edge. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.SectionLabel"
                    android:text="Cultivation Cycle"
                    android:layout_marginBottom="@dimen/ds_space_xs" />

                <Spinner
                    android:id="@+id/spinnerCycle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ds_selector_height"
                    android:paddingStart="0dp"
                    android:paddingEnd="32dp"
                    android:background="@drawable/ds_selector_bg_flat"
                    android:theme="@style/ThemeOverlay.AppCompat.Light" />

                <View style="@style/Basilience.Divider" />

                <!-- PARAMETER SELECTOR -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.SectionLabel"
                    android:text="Parameter"
                    android:layout_marginTop="@dimen/ds_space_lg"
                    android:layout_marginBottom="@dimen/ds_space_xs" />

                <Spinner
                    android:id="@+id/spinnerParameter"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ds_selector_height"
                    android:paddingStart="0dp"
                    android:paddingEnd="32dp"
                    android:background="@drawable/ds_selector_bg_flat"
                    android:entries="@array/parameters_array"
                    android:theme="@style/ThemeOverlay.AppCompat.Light" />

                <View style="@style/Basilience.Divider" />

                <!-- PERIOD FILTER: one segmented-control track, five equal
                     segments - only the active segment gets a filled pill. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Basilience.SectionLabel"
                    android:text="Period"
                    android:layout_marginTop="@dimen/ds_space_lg"
                    android:layout_marginBottom="@dimen/ds_space_xs" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/ds_segment_track_bg"
                    android:padding="3dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEntireCycle"
                        style="@style/Basilience.SegmentChip.Selected"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Entire"
                        android:layout_marginEnd="2dp"
                        android:padding="0dp"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToday"
                        style="@style/Basilience.SegmentChip"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Today"
                        android:layout_marginEnd="2dp"
                        android:padding="0dp"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWeek"
                        style="@style/Basilience.SegmentChip"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="7D"
                        android:layout_marginEnd="2dp"
                        android:padding="0dp"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonth"
                        style="@style/Basilience.SegmentChip"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="30D"
                        android:layout_marginEnd="2dp"
                        android:padding="0dp"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCustom"
                        style="@style/Basilience.SegmentChip"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Custom"
                        android:padding="0dp"
                        app:backgroundTint="@null" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEffectiveRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    style="@style/Basilience.Caption"
                    android:layout_marginTop="@dimen/ds_space_md"
                    android:text="" />

                <!-- INSIGHT HERO: one grouped surface - status badge, then
                     evidence, then a thin internal rule, then the primary
                     threshold/range value. A slim status-colored edge and
                     dot are the only accent color; the card itself stays a
                     restrained neutral/green tint. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardInsightHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_lg"
                    app:cardCornerRadius="@dimen/ds_surface_radius"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/ds_hero_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/heroAccentEdge"
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:background="@color/ds_divider" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/ds_surface_padding">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <View
                                    android:id="@+id/dotInsightStatus"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_marginEnd="8dp"
                                    android:background="@drawable/ds_dot"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/tvInsightStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/Basilience.StatusBadge"
                                    android:text="SELECT A PARAMETER"
                                    android:textColor="@color/nav_inactive"
                                    android:background="@drawable/ds_status_pill_neutral"
                                    android:paddingHorizontal="14dp"
                                    android:paddingVertical="6dp"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvEvidence"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                style="@style/Basilience.BodyMuted"
                                android:layout_marginTop="@dimen/ds_space_sm"
                                android:text="" />

                            <View
                                style="@style/Basilience.Divider"
                                android:layout_marginTop="@dimen/ds_space_sm"
                                android:layout_marginBottom="@dimen/ds_space_sm" />

                            <TextView
                                android:id="@+id/tvTargetRange"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                style="@style/Basilience.HeroValue"
                                android:text="" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KEY METRICS: compact typography-first row, no filled
                     tiles - the surrounding gaps above/below already give it
                     room to breathe. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_lg"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvAverage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Basilience.MetricValue"
                            android:text="--" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Basilience.MetricLabel"
                            android:layout_marginTop="2dp"
                            android:text="Average" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:background="@color/ds_divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvHigh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Basilience.MetricValue"
                            android:text="--" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Basilience.MetricLabel"
                            android:layout_marginTop="2dp"
                            android:text="Highest" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:background="@color/ds_divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvLow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Basilience.MetricValue"
                            android:text="--" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Basilience.MetricLabel"
                            android:layout_marginTop="2dp"
                            android:text="Lowest" />
                    </LinearLayout>
                </LinearLayout>

                <!-- CHART SURFACE: one subtle neutral surface, title
                     integrated inside it instead of floating above. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_xl"
                    android:orientation="vertical"
                    android:background="@drawable/ds_surface_chart_bg"
                    android:padding="@dimen/ds_surface_padding">

                    <TextView
                        android:id="@+id/tvChartTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.SectionTitle"
                        android:text="Parameter Trend" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.Caption"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="@dimen/ds_space_md"
                        android:text="Readings across the selected period" />

                    <com.example.basilience.ThresholdBandLineChart
                        android:id="@+id/lineChart"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ds_chart_height" />
                </LinearLayout>

                <!-- WHAT THIS MEANS: a lighter, less prominent surface from
                     the same soft-green family as the insight hero. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_xl"
                    android:orientation="vertical"
                    android:background="@drawable/ds_surface_interpretation_bg"
                    android:padding="@dimen/ds_surface_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.SectionTitle"
                        android:text="What This Means"
                        android:layout_marginBottom="@dimen/ds_space_sm" />

                    <TextView
                        android:id="@+id/tvInterpretation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Basilience.BodyMuted"
                        android:text="Select a cycle and parameter to view a report." />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- LOADING OVERLAY -->
    <RelativeLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:cardCornerRadius="20dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp">

                <ProgressBar
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:indeterminateTint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Loading report..."
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
