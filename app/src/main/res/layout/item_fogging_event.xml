<?xml version="1.0" encoding="utf-8"?>
<!-- Recent Fogging Activity row. Presented as an activity-feed entry rather
     than a bordered card per record: a small status dot, the session time,
     the muted source/strategy line, and the duration/state on the right,
     separated from the next row by a thin divider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="12dp">

        <View
            android:id="@+id/dotActivity"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/ds_dot" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="May 20, 10:00 AM"
                android:textColor="@color/text_dark"
                android:fontFamily="sans-serif-medium"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Automatic"
                android:textSize="13sp"
                android:textColor="@color/nav_inactive" />
        </LinearLayout>

        <!-- wrap_content, not a fixed width: this text varies a lot in length
             ("5m 0s" vs "Running now · 25h 48m" vs "Incomplete fogging
             record") and must never clip on narrow phones. -->
        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="end"
            android:maxLines="2"
            android:text="2m 30s"
            android:textSize="13sp"
            android:textColor="@color/text_dark"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <View
        android:id="@+id/activityDivider"
        style="@style/Basilience.Divider" />

</LinearLayout>
