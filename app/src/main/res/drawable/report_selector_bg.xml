<?xml version="1.0" encoding="utf-8"?>
<!-- Modern full-width selector-row background for the Cycle and Parameter
     spinners: soft brand-tinted border instead of the generic gray outline,
     with the dropdown chevron baked in, matching spinner_outline_bg's
     structure. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <stroke android:width="1.5dp" android:color="#D7E7E1" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:gravity="end|center_vertical"
        android:drawable="@drawable/ic_arrow_drop_down"
        android:right="14dp" />
</layer-list>
