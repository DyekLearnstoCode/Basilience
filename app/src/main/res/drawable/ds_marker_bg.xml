<?xml version="1.0" encoding="utf-8"?>
<!-- Chart tap-marker surface: white with a thin neutral border, small
     radius - deliberately quieter than the report's section surfaces. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/white" />
    <stroke android:width="1dp" android:color="@color/ds_chip_border" />
    <corners android:radius="8dp" />
</shape>
