<?xml version="1.0" encoding="utf-8"?>
<!-- V2: context selector row - no boxed outline at all (a bottom divider
     View placed after the Spinner in the layout provides the row's only
     edge), just the dropdown chevron. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item
        android:gravity="end|center_vertical"
        android:drawable="@drawable/ic_arrow_drop_down"
        android:right="2dp" />
</layer-list>
