<?xml version="1.0" encoding="utf-8"?>
<!-- V2 chart surface - neutral gray (not green-tinted) so the chart's own
     data line/legend stay the only green inside this surface. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/ds_surface_neutral" />
    <stroke android:width="1dp" android:color="@color/ds_divider" />
    <corners android:radius="@dimen/ds_surface_radius" />
</shape>
