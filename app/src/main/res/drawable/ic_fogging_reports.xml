<?xml version="1.0" encoding="utf-8"?>
<!-- Fogging Reports icon.
     Drawn to match the existing updated Basilience icon family used on the
     Dashboard and Settings screens (ic_parameters_monitoring, ic_user_guide,
     ic_cycle_details, ic_account_info): a 24dp two-tone vector whose primary
     form uses @color/text_dark with an @color/icon_secondary_green accent.
     Created only because no existing asset in that family represents
     fogging - the white-fill ic_water_drop_24/ic_humidity belong to the
     nav/status family and already mean water level and humidity. -->
