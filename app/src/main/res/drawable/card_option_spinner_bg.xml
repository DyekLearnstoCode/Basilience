<?xml version="1.0" encoding="utf-8"?>
<!-- Same pill look as card_option, with the dropdown chevron baked in so the
     Automation Test Mode spinner reads as a selector, not a static label. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80116F59" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:gravity="end|center_vertical"
        android:drawable="@drawable/ic_arrow_drop_down"
        android:right="10dp" />
</layer-list>
