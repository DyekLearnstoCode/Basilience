<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle brand-green-to-transparent fill beneath the cumulative harvest
     line. Deliberately low-opacity: it should read as a soft weight under
     the line, never as a decorative flourish that competes with the data. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#33116F59"
        android:endColor="#00116F59" />
</shape>
