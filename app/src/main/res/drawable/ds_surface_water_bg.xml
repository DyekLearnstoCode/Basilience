<?xml version="1.0" encoding="utf-8"?>
<!-- Water Outlook surface. Uses the same radius as the other Basilience
     surfaces but keeps its established soft-blue tint, because Water Outlook
     is current/predictive and independent of the selected report period -
     that distinction must stay visually obvious. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/water_outlook_bg" />
    <stroke android:width="1dp" android:color="@color/water_outlook_border" />
    <corners android:radius="@dimen/ds_surface_radius" />
</shape>
