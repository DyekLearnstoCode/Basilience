<?xml version="1.0" encoding="utf-8"?>
<!-- V2: single track surface the period filter segments sit inside, so the
     five buttons read as one segmented control rather than separate chips. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/white" />
    <stroke android:width="1dp" android:color="@color/ds_chip_border" />
    <corners android:radius="10dp" />
</shape>
