    <!-- Soft status-accent containers for report status summaries (Reports UI
         modernization). Paired bg/border tints of the existing semantic
         state colors above - used as a restrained accent, never a solid
         saturated block. -->
    <color name="state_success_bg">#E6F4EA</color>
    <color name="state_success_border">#A8D5B5</color>
    <color name="state_warning_bg">#FFF4E0</color>
    <color name="state_warning_border">#F5D28C</color>
    <color name="state_critical_bg">#FDECEA</color>
    <color name="state_critical_border">#F3B4AE</color>
    <color name="state_neutral_bg">#EFEFEF</color>
    <color name="state_neutral_border">#D6D6D6</color>

    <!-- Water Outlook is current/predictive, not part of the selected
         historical report - a distinct soft blue tint keeps that visually
         obvious without a heavy banner. -->
    <color name="water_outlook_bg">#EAF3FB</color>
    <color name="water_outlook_border">#BEE0F5</color>

    <!-- Basilience Design System pilot (Parameter Report). Additive only -
         the report_*/bg_chip/status_container_* tokens above stay untouched
         since Fogging and Harvest reports still use them until ported. -->
    <color name="ds_divider">#EAEAEA</color>
    <color name="ds_chip_border">#DCDCDC</color>

    <!-- V2: the "small number of intentional surfaces" - insight hero,
         interpretation and chart surfaces each get one flat, restrained
         tint instead of a saturated card fill. Hero/interpretation share
         the same soft green family (interpretation is the lighter, less
         prominent of the two); the chart surface is neutral gray so the
         chart data itself stays the only green in that surface. -->
    <color name="ds_hero_bg">#F2F8F5</color>
    <color name="ds_interpretation_bg">#F8FBFA</color>
    <color name="ds_surface_neutral">#FAFAFA</color>
    <!-- Notification filter chips: fixed Basilience surface colours so the
         chips never fall back to a Material/framework default. -->
    <color name="chip_filter_selected">#2E7D6B</color>
    <color name="chip_filter_unselected">#D7E7E1</color>
    <color name="chip_filter_text_selected">#FFFFFFFF</color>
    <color name="chip_filter_text_unselected">#0F3B2E</color>
    <color name="chip_filter_ripple">#332E7D6B</color>
