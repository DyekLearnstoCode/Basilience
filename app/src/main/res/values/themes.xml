<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 1. Base Theme: This is the main engine for your app's look -->
    <style name="Theme.Basilience" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/celadon</item>
        <item name="android:statusBarColor">@color/celadon</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!-- 2. Splash Screen Theme: Keep this exactly as is -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/celadon</item>
        <item name="postSplashScreenTheme">@style/Theme.Basilience</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/animated_logo</item>
        <item name="splashScreenIconSize">200dp</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 3. Custom Component Styles (Keep these) -->
    <style name="InputFieldStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@android:color/white</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="android:textColorHint">#A0A0A0</item>
        <item name="endIconTint">@color/primary</item>
    </style>

    <style name="FilterChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">#0F3B2E</item>
    </style>

    <style name="FilterChipSelected" parent="FilterChip">
        <item name="android:background">@drawable/bg_chip_selected</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="BasilienceButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingLeft">@dimen/button_horizontal_padding</item>
        <item name="android:paddingRight">@dimen/button_horizontal_padding</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <style name="BasilienceButton.Primary" parent="BasilienceButton">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/onPrimary</item>
    </style>

    <style name="BasilienceButton.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingLeft">@dimen/button_horizontal_padding</item>
        <item name="android:paddingRight">@dimen/button_horizontal_padding</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="strokeColor">@color/primary</item>
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="BasilienceButton.Danger" parent="BasilienceButton">
        <item name="backgroundTint">@color/alert_red</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="ScreenContainerCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/top_rounded_white</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- 4. Dialog Themes -->
    <style name="HarvestDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/snow</item>
        <item name="android:textColorPrimary">@color/black</item>
    </style>

</resources>
