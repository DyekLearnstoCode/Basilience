<?xml version="1.0" encoding="utf-8"?>
<!--
   Basilience keeps no data worth backing up on the phone: the account, devices,
   cycles and history all live in Firebase, and what is stored locally is the
   signed-in session (role, developer flags, selected device), Firebase Auth
   and FCM state, an offline copy of Firestore and the notification cache.
   Restoring any of that onto another phone would bring back a session and
   privileges that no longer match the real sign-in. android:allowBackup is
   false; these explicit exclusions keep cloud backup and device-to-device
   transfer closed even if that flag is ever changed.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
